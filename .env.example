# JWT_SECRET: Secret key used to sign authentication tokens.
# Replace with a long random string in production.
JWT_SECRET="dormfind-change-this-secret-in-production"

# PORT: Server port (must be 3000 in AI Studio).
PORT="3000"

# DB_PATH: Optional path to the SQLite database file.
DB_PATH="./data/dormfind.db"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps JavaScript API key for interactive campus & item GPS pins.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls if AI extensions are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
